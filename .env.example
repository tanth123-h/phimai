# Local/ngrok server
PORT=8000
ENABLE_CAMERA_WORKER=true
LOG_LEVEL=INFO
DEFAULT_CAMERA_LIMIT=15
YOLO_MODEL_PATH=yolov8m.pt
DATABASE_URL=

# Camera RTSP URLs. You can also edit these from the staff dashboard.
CAMERA_MAIN_PRANG_RTSP_URL=rtsp://user:password@camera-ip:554/stream2
CAMERA_SOUTH_GOPURA_RTSP_URL=rtsp://user:password@second-camera-ip:554/stream2

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_ID=
LINE_VENDOR_TARGET_ID=
LINE_ALERT_COOLDOWN_SECONDS=300

# Optional VPN helper for remote camera networks. Keep VPN_TYPE=none for normal local/ngrok use.
VPN_TYPE=none
VPN_CONFIG_PATH=
VPN_CHECK_IP=
VPN_AUTO_CONNECT=true
VPN_CHECK_INTERVAL_SECONDS=10
